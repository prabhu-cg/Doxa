# Copy to .env.local and fill in real values. Never commit .env.local.
# Full reference: docs/environment.md

# ---- Browser-safe (exposed to client bundle via NEXT_PUBLIC_ prefix) ----
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Server-only (never exposed to the browser) ----
# Supabase Settings > Database > Connection string > "Transaction" pooler.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Supabase Settings > Database > Connection string > "Session" / direct connection.
# Used by Prisma Migrate, which needs a non-pooled connection.
DIRECT_URL="postgresql://user:password@host:5432/postgres"
# Supabase Settings > API > service_role key. Bypasses Row Level Security —
# server-only, must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (transactional email) — optional. Without it, the contact form
# still works but just logs the submission server-side instead of
# emailing anyone.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Where /contact submissions get sent, once RESEND_API_KEY is set.
CONTACT_NOTIFICATION_EMAIL=""
